# ===================================================================
# KONFIGURASI ENVIRONMENT ANTREAN RS
# PENTING: Jangan commit file .env yang berisi password asli ke Git!
# ===================================================================

# 1. Konfigurasi Database MySQL / MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=GantiDenganPasswordDatabaseAnda!
DB_NAME=antrean_rs

# 2. Kunci Rahasia JWT (Wajib diisi string acak minimal 32 karakter untuk produksi)
JWT_SECRET=ganti_dengan_random_secret_token_32_karakter_acak_disini

# 3. Kredensial Awal Pengguna Baru (Opsional, hanya dipakai saat database diinstal pertama kali)
INITIAL_ADMIN_PASSWORD=PasswordAdminKuat123!
INITIAL_PENDAFTARAN_PASSWORD=PasswordPendaftaranKuat123!
INITIAL_POLIKLINIK_PASSWORD=PasswordPoliklinikKuat123!
INITIAL_FARMASI_PASSWORD=PasswordFarmasiKuat123!

# 4. Port & Jaringan
PORT=3001
CORS_ORIGIN=*
